# Generated posters (rebuild with print/build.py for your domain); only the QR codes are kept
print/out/*/*
!print/out/*/qr/

# Raw source material (originals of what is in site/img, internal documents)
*.docx
*.pdf
BucketRecognition/
ExtraPic/
IMUAndGNSS/
RadarAndCameraDetection */
RealTimePosEstimation/
StudentWorker/
SurfaceLogging/
VR_GameEngine/
__pycache__/

# Downloaded videos (large)
videos/

# Ready-to-print posters are kept too (must come after the *.pdf rule above)
!print/out/*/pdf/
!print/out/*/pdf/*.pdf
!print/out/*/all-posters.pdf
